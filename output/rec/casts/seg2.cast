{"version": 2, "width": 120, "height": 36, "timestamp": 1794594552, "idle_time_limit": 1.5, "title": "AVIF lossless support - segment 2/4 - lossless recompression", "env": {"SHELL": "/bin/bash", "TERM": "xterm-256color"}}
[0.5, "o", "\r\n\r\n"]
[0.68, "o", "  \u001b[1;46m  SEGMENT 2/4  LOSSLESS: recompress, verify pixels, never grow  \u001b[0m\r\n\r\n"]
[0.86, "o", "$ ls -l *.avif                         # originals\r\n"]
[1.04, "o", "  12849  ref_10bit.avif\r\n"]
[1.22, "o", "  1146  ref_alpha.avif\r\n"]
[1.4, "o", "  1657  ref_bars.avif\r\n"]
[1.58, "o", "  14832  ref_fast_lossless.avif\r\n\r\n"]
[1.76, "o", "$ ffmpeg -i ref_fast_lossless.avif -f rawvideo rgb48 orig.raw   # reference pixels\r\n"]
[1.94, "o", "  reference raw frame captured\r\n\r\n"]
[2.12, "o", "$ ./leanify -v *.avif\r\n"]
[2.3, "o", "  Processing: ref_10bit.avif\r\n"]
[2.48, "o", "  AVIF detected.\r\n"]
[2.66, "o", "  AVIF recompressed size is not smaller, keeping original.\r\n"]
[2.84, "o", "  12.55 KB -> 12.55 KB\tLeanified: 0 B (0.00%)\r\n"]
[3.02, "o", "  Processing: ref_alpha.avif\r\n"]
[3.2, "o", "  AVIF detected.\r\n"]
[3.38, "o", "  AVIF recompressed size is not smaller, keeping original.\r\n"]
[3.56, "o", "  1.12 KB -> 1.12 KB\tLeanified: 0 B (0.00%)\r\n"]
[3.74, "o", "  Processing: ref_bars.avif\r\n"]
[3.92, "o", "  AVIF detected.\r\n"]
[4.1, "o", "  AVIF losslessly recompressed, 70 bytes removed.\r\n"]
[4.28, "o", "  1.62 KB -> 1.55 KB\tLeanified: 70 B (4.22%)\r\n"]
[4.46, "o", "  Processing: ref_fast_lossless.avif\r\n"]
[4.64, "o", "  AVIF detected.\r\n"]
[4.82, "o", "  AVIF losslessly recompressed, 154 bytes removed.\r\n"]
[5.0, "o", "  14.48 KB -> 14.33 KB\tLeanified: 154 B (1.04%)\r\n\r\n"]
[5.18, "o", "$ ffmpeg -i ref_fast_lossless.avif -f rawvideo rgb48 new.raw\r\n"]
[5.36, "o", "$ cmp orig.raw new.raw && echo PIXEL-IDENTICAL\r\n"]
[5.54, "o", "  PIXEL-IDENTICAL\r\n\r\n"]
