[0.5, "o", "\r\n\r\n"]
[0.68, "o", "  \u001b[1;46m  SEGMENT 1/4  BUILD: optional libavif, auto-detected by pkg-config  \u001b[0m\r\n\r\n"]
[0.86, "o", "$ export PKG_CONFIG_PATH=/tmp/pkgcfg        # static libavif + libaom\r\n"]
[1.04, "o", "$ make                                        # wildcard picks formats/avif.cpp\r\n\r\n"]
[1.22, "o", "  g++ ... -DENABLE_AVIF -I/tmp/libavif-static-install/include  -c -o formats/avif.o formats/avif.cpp\r\n"]
[1.4, "o", "  g++ ... -o leanify   (libavif.a + libaom.a inlined via LTO)\r\n"]
[1.58, "o", "  build finished, exit code 0\r\n\r\n"]
[1.76, "o", "$ file leanify && readelf -d leanify | grep NEEDED   # self-contained, no new runtime deps\r\n"]
